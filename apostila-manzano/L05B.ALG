Algoritmo "L05B"
// Disciplina   : [Linguagem e Lógica de Programação]
// Professor   : Jailson
// Descrição   : Apresentar os resultados de uma tabuada de multiplicar
//(de 1 até 10) de um número qualquer.
// Autor(a)    : Maria Eduarda Lima da Silva
// Data atual  : 22/09/2026
Var
// Seção de Declarações das variáveis
   multiplicacao, contador, valor: inteiro

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc...
   para contador de 1 ate 10 passo 1 faca
   valor<- 2
   multiplicacao<- contador * valor
   escreval("O resultado de ", valor, " x ", contador, " é ", multiplicacao)
   fimpara

Fimalgoritmo